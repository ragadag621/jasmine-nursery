# --- Server ---
NODE_ENV=development
PORT=5000

# --- Database (MongoDB Atlas connection string) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/alyasmin-nursery

# --- Auth ---
# Generate a strong random value for production, e.g.: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=alyasmin_admin_token

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- CORS / cookie origin ---
# Must exactly match the deployed frontend origin (no trailing slash)
# so the httpOnly auth cookie is accepted cross-origin.
CLIENT_URL=http://localhost:5173

# --- Dev/initial admin seed (used only by `npm run seed:admin`) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@alyasmin-nursery.local
SEED_ADMIN_PASSWORD=ChangeMe123!
