# =====================================================================
# Backend — Environment Variables
# Copy this file to .env and fill in real values before running the app.
# Variables marked (required) MUST be set in production; sensible dev
# placeholders are used automatically if omitted locally (see src/config/env.ts).
# =====================================================================

# --- Server ---
# development | production | test
NODE_ENV=development
# Port the Express server listens on
PORT=5000

# --- Database ---
# (required in production) MongoDB Atlas connection string, including the
# database name. Get this from Atlas > Connect > Drivers.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/example-nursery

# --- Auth / JWT ---
# (required in production) Secret used to sign JWTs. Generate a strong
# random value, e.g.: openssl rand -base64 48
# Never reuse the dev placeholder in production.
JWT_SECRET=replace-with-a-long-random-secret
# How long an issued token (and its cookie) remains valid.
JWT_EXPIRES_IN=7d
# Name of the httpOnly cookie the JWT is stored in. The frontend never
# reads this value directly — it's set/cleared entirely by the backend.
COOKIE_NAME=example_admin_token

# --- Cloudinary (image storage) ---
# (required in production) From your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- CORS / cookie origin ---
# Must exactly match the deployed frontend origin (no trailing slash),
# e.g. https://example-nursery.vercel.app in production.
# Required for the httpOnly auth cookie to be accepted cross-origin
# (frontend on Vercel, backend on Render).
CLIENT_URL=http://localhost:5173

# --- Dev/initial admin seed ---
# Only read by `npm run seed:admin`. Not used by the running server.
# Change SEED_ADMIN_PASSWORD before seeding a real/production database —

SEED_ADMIN_USERNAME=example-admin
SEED_ADMIN_EMAIL=example@example-nursery.local
SEED_ADMIN_PASSWORD=replace-with-a-strong-random-password